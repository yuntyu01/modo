<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- 위젯·잠금화면에서 바꾼 것을 앱 없이 서버로 보내는 작업(NotesSync): 인터넷이 될 때 돌게 건다 -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- DB를 여는 부품은 모두 :native 프로세스(ModoEvents.kt 설명). -->
  <application>
    <!-- 위젯 +·잠금화면 알림의 '추가'가 여는 입력줄(RN 없이 키보드 위에 바로). 따로 도는 '빠른 추가' 앱 아이콘·빠른 설정 타일은
         뺐다(사용자 요청 2026-10-21): 이 앱의 위젯·알림만 연다 -->
    <activity
      android:name="com.yuntyu01.naegirok.QuickAddActivity"
      android:process=":native"
      android:exported="false"
      android:label="@string/quick_add"
      android:taskAffinity="com.yuntyu01.naegirok.quickadd"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:theme="@style/Modo.QuickAdd"
      android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

    <!-- 위젯에서 글자를 누르면 뜨는 고치기 창(앱을 띄우지 않음) -->
    <activity
      android:name="com.yuntyu01.naegirok.WidgetEditActivity"
      android:process=":native"
      android:exported="false"
      android:taskAffinity="com.yuntyu01.naegirok.widgetedit"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:theme="@style/Modo.QuickAdd"
      android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

    <receiver android:name="com.yuntyu01.naegirok.widget.NotesWidgetProvider"
      android:process=":native" android:exported="true" android:label="@string/app_name_widget">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/naegirok_widget_info" />
    </receiver>
    <!-- 같은 위젯을 위젯 고르기 화면에 4×4로도(WidgetSizes.kt). 기본은 위의 3×3(잠금화면도 그것) -->
    <receiver android:name="com.yuntyu01.naegirok.widget.NotesWidgetProvider4x4"
      android:process=":native" android:exported="true" android:label="@string/app_name_widget">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/naegirok_widget_info_4x4" />
    </receiver>
    <!-- 2×2(작게, WidgetSizes.kt) -->
    <receiver android:name="com.yuntyu01.naegirok.widget.NotesWidgetProvider2x2"
      android:process=":native" android:exported="true" android:label="@string/app_name_widget">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/naegirok_widget_info_2x2" />
    </receiver>
    <!-- 한 줄(4×1): 폴더 고르기 · 할 일 하나씩. 잠금화면의 넓은 칸에도(WidgetSizes.kt) -->
    <receiver android:name="com.yuntyu01.naegirok.widget.NotesWidgetProvider4x1"
      android:process=":native" android:exported="true" android:label="@string/app_name_widget">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/naegirok_widget_info_4x1" />
    </receiver>


    <activity
      android:name="com.yuntyu01.naegirok.widget.WidgetConfigActivity"
      android:process=":native"
      android:exported="true"
      android:theme="@style/Modo.Config">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <receiver android:name="com.yuntyu01.naegirok.RefreshReceiver" android:process=":native" android:exported="false" />
    <service android:name="com.yuntyu01.naegirok.SyncJobService"
      android:process=":native" android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver android:name="com.yuntyu01.naegirok.notify.ReminderReceiver"
      android:process=":native" android:exported="false" />
    <receiver android:name="com.yuntyu01.naegirok.notify.BootReceiver"
      android:process=":native" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
