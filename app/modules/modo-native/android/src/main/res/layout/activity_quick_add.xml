<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/qa_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">

  <!-- 카드나 제목 없이 입력줄 하나만 키보드 바로 위에 띄운다 -->
  <LinearLayout
    android:id="@+id/qa_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="14dp"
    android:maxWidth="560dp"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/qa_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:minHeight="64dp"
      android:orientation="horizontal"
      android:paddingStart="24dp"
      android:paddingEnd="6dp">

      <EditText
        android:id="@+id/qa_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/new_todo"
        android:importantForAutofill="no"
        android:maxLength="5000"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="18sp" />

      <ImageButton
        android:id="@+id/qa_send"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/naegirok_circle"
        android:contentDescription="@string/add"
        android:src="@drawable/naegirok_arrow_up"
        android:visibility="gone" />

      <ImageButton
        android:id="@+id/qa_toggle"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@null"
        android:contentDescription="@string/input_as_todo"
        android:src="@drawable/naegirok_check_square" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
