<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 화면 위젯(시안): 로고 · 폴더 탭(한 줄, 앱과 같이) / [첫 쪽: 메모만 | 다음 쪽부터: 할 일만] / 쪽 점 · +(할 일 쪽만).
  메모를 누르면 메모 읽기 모드(본문을 쪽으로 나눠 보여 준다). 줄·점은 HomeWidget이 채운다.
  잠금화면 위젯은 widget_notes_lock(그대로).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />

  <!-- 여백은 HomeWidget의 PAD_* 값과 같아야 한다(쪽 계산) -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="34dp">

    <!-- 머리 한 줄(36dp): 맨 왼쪽 로고(글자 없이, 누르면 앱) + 폴더 탭(앱과 같이, 누르면 그 폴더로. 지금 폴더는 굵은 글자) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <FrameLayout
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="14dp">
        <ImageView
          android:id="@+id/widget_mark"
          android:layout_width="wrap_content"
          android:layout_height="15dp"
          android:layout_gravity="center_vertical"
          android:adjustViewBounds="true"
          android:importantForAccessibility="no"
          android:src="@drawable/naegirok_mark" />
      </FrameLayout>
      <LinearLayout
        android:id="@+id/widget_tabs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
    </LinearLayout>

    <!-- 메모 쪽·메모 읽기 쪽: 할 일 자리까지 한 쪽씩(줄 수는 HomeWidget이 잰다, 넘치면 마지막 줄 …) -->
    <TextView
      android:id="@+id/widget_memo"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:breakStrategy="simple"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:gravity="top|start"
      android:hyphenationFrequency="none"
      android:letterSpacing="-0.016"
      android:lineSpacingMultiplier="1.3"
      android:paddingTop="4dp"
      android:paddingEnd="10dp"
      android:paddingBottom="4dp"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/widget_rows"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingEnd="10dp" />

    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:paddingEnd="10dp"
      android:textColor="#A1A1A6"
      android:textSize="14sp"
      android:visibility="gone" />
  </LinearLayout>

  <!-- 아래 줄(32 + 아래 여백 2): 쪽 점은 위젯 가운데, +는 오른쪽. 마지막 할 일과 점이 멀어지지 않게 낮게 -->
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_gravity="bottom"
    android:layout_marginBottom="2dp">
    <LinearLayout
      android:id="@+id/widget_dots"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      android:layout_gravity="center"
      android:orientation="horizontal" />
    <ImageView
      android:id="@+id/widget_add"
      android:layout_width="44dp"
      android:layout_height="32dp"
      android:layout_gravity="end|center_vertical"
      android:layout_marginEnd="8dp"
      android:contentDescription="@string/add"
      android:paddingStart="11dp"
      android:paddingTop="5dp"
      android:paddingEnd="11dp"
      android:paddingBottom="5dp"
      android:src="@drawable/naegirok_add" />
  </FrameLayout>
</FrameLayout>
