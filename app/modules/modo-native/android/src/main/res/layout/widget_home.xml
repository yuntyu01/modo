<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 화면 위젯(시안): 로고 · 폴더 탭(한 줄, 앱과 같이) / 메모(맨 위, 전체)와 할 일을 한 목록으로(위아래로 굴려 본다) / +는 오른쪽 아래.
  목록 끝에 + 자리만큼 여백을 둬서 끝까지 굴리면 마지막 할 일이 +에 가리지 않는다. 줄은 HomeWidget이 채운다.
  예전엔 쪽(메모 쪽 + 할 일 쪽)을 나눠 아래 점으로 넘겼다: 위젯은 옆으로 미는 손짓을 받을 수 없어 위아래 굴리기로(사용자 요청 2026-10-21).
  잠금화면 위젯은 widget_notes_lock(그대로).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />

  <!-- 여백은 HomeWidget의 PAD_* 값과 같아야 한다(쪽 계산) -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp">

    <!-- 머리 한 줄(36dp): 맨 왼쪽 로고(글자 없이, 누르면 앱) + 폴더 탭(앱과 같이, 누르면 그 폴더로. 지금 폴더는 굵은 글자) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <FrameLayout
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="14dp">
        <ImageView
          android:id="@+id/widget_mark"
          android:layout_width="wrap_content"
          android:layout_height="15dp"
          android:layout_gravity="center_vertical"
          android:adjustViewBounds="true"
          android:importantForAccessibility="no"
          android:src="@drawable/naegirok_mark" />
      </FrameLayout>
      <LinearLayout
        android:id="@+id/widget_tabs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
    </LinearLayout>

    <!-- 메모 + 할 일 목록(HomeWidget이 RemoteCollectionItems로 채운다). 아래 여백 40 = + 자리 -->
    <ListView
      android:id="@+id/widget_list"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:divider="@null"
      android:dividerHeight="0dp"
      android:listSelector="@android:color/transparent"
      android:overScrollMode="never"
      android:paddingEnd="10dp"
      android:paddingBottom="40dp"
      android:scrollbars="none" />

    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:paddingEnd="10dp"
      android:textColor="#A1A1A6"
      android:textSize="14sp"
      android:visibility="gone" />
  </LinearLayout>

  <!-- +: 오른쪽 아래(아래 끝에서 4 + 32/2 = 20dp로 머리 로고 가운데가 위 끝에서 떨어진 만큼과 같다). 오른쪽 끝에서 8dp 더 안쪽
       (실기기에서 한쪽 끝에 몰려 보였다, 사용자 요청 2026-10-21). 목록 위에 떠 있다 -->
  <ImageView
    android:id="@+id/widget_add"
    android:layout_width="40dp"
    android:layout_height="32dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:contentDescription="@string/add"
    android:paddingStart="9dp"
    android:paddingTop="5dp"
    android:paddingEnd="9dp"
    android:paddingBottom="5dp"
    android:src="@drawable/naegirok_add" />
</FrameLayout>
