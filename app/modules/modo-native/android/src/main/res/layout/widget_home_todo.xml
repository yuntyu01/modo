<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 위젯 할 일 한 줄(상자·구분선 없음): 동그라미 = 완료, 글자 = 그 할 일 고치기.
  동그라미는 왼쪽(item_check) 또는 오른쪽(item_check_end) 하나만 보인다(꾸미기 홈 위젯 탭의 체크 위치, 사용자 요청 2026-10-24).
  줄 높이는 HomeWidget이 글자 높이로 정해 모든 줄이 같다(보조 줄 없는 줄은 제목이 세로 가운데).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/item_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingTop="4dp"
  android:paddingBottom="4dp">
  <!-- 동그라미(누르면 완료): 빈 동그라미 → 채운 동그라미 + 체크로 바뀌며(톡 커지는 움직임) 잠시 뒤 줄이 빠진다.
       동그라미는 25dp(예전 21dp는 작아 보였다, 사용자 요청 2026-10-22).
       칸(44dp)은 누르기 쉽게 크고 줄 밖으로 10dp 나간다. 예전 12dp는 동그라미 테두리(약 0.8dp)와 완료 때 채운 원(1dp)이
       줄 끝에 걸려 옆이 조금 잘렸다(사용자 제보 2026-10-30): 10dp면 테두리 1.2dp · 채운 원 1dp 안쪽, 톡 커지는 움직임까지 들어간다 -->
  <ViewFlipper
    android:id="@+id/item_check"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginStart="-10dp"
    android:inAnimation="@anim/widget_check_in"
    android:outAnimation="@anim/widget_check_out">
    <ImageView
      android:id="@+id/item_ring"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:padding="9.5dp"
      android:src="@drawable/naegirok_check_off" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">
      <ImageView
        android:id="@+id/item_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:src="@drawable/naegirok_circle" />
      <ImageView
        android:id="@+id/item_tick"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/naegirok_tick" />
    </FrameLayout>
  </ViewFlipper>
  <LinearLayout
    android:id="@+id/item_body"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="8dp">
    <TextView
      android:id="@+id/item_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:gravity="center_vertical"
      android:letterSpacing="-0.02"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/item_meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="0dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:fontFeatureSettings="tnum"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:textColor="#A1A1A6"
      android:textSize="13sp"
      android:visibility="gone" />
  </LinearLayout>
  <!-- 오른쪽 동그라미(체크 위치 = 오른쪽): 왼쪽 것과 같은 모양, 바깥으로 같은 만큼(10dp) -->
  <ViewFlipper
    android:id="@+id/item_check_end"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="-10dp"
    android:inAnimation="@anim/widget_check_in"
    android:outAnimation="@anim/widget_check_out"
    android:visibility="gone">
    <ImageView
      android:id="@+id/item_ring_end"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:padding="9.5dp"
      android:src="@drawable/naegirok_check_off" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">
      <ImageView
        android:id="@+id/item_fill_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="11dp"
        android:src="@drawable/naegirok_circle" />
      <ImageView
        android:id="@+id/item_tick_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/naegirok_tick" />
    </FrameLayout>
  </ViewFlipper>
</LinearLayout>
