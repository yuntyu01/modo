<?xml version="1.0" encoding="utf-8"?>
<!--
  한 줄만 들어가는 낮은 칸(삼성 잠금화면의 넓은 칸 등, HomeWidget.line): 동그라미(완료) · 할 일 한 줄(누르면 다음 할 일) · 몇 번째/몇 개(맨 오른쪽).
  화살표 단추 없이 글자나 몇 번째/몇 개를 누르면 넘어간다(마지막에서 누르면 처음으로, 사용자 요청 2026-10-23).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/line_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="14dp">
    <ViewFlipper
      android:id="@+id/line_check"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:inAnimation="@anim/widget_check_in"
      android:outAnimation="@anim/widget_check_out">
      <ImageView
        android:id="@+id/line_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/naegirok_check_off" />
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
          android:id="@+id/line_fill"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:padding="8.5dp"
          android:src="@drawable/naegirok_circle" />
        <ImageView
          android:id="@+id/line_tick"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:padding="9.5dp"
          android:src="@drawable/naegirok_tick" />
      </FrameLayout>
    </ViewFlipper>
    <TextView
      android:id="@+id/line_text"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="4dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="15sp" />
    <TextView
      android:id="@+id/line_pos"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginStart="10dp"
      android:fontFamily="sans-serif"
      android:fontFeatureSettings="tnum"
      android:gravity="center_vertical"
      android:textColor="#A1A1A6"
      android:textSize="12sp" />
  </LinearLayout>
</FrameLayout>
