<?xml version="1.0" encoding="utf-8"?>
<!--
  잠금화면·작은 칸 위젯(HomeWidget.card): 위 = 로고(누르면 앱) · 폴더 이름 · 이전/다음 폴더, 아래 = 할 일 하나
  (동그라미 = 완료 · 할 일 · 아래 줄(날짜·반복) · 몇 번째/몇 개). 글자나 몇 번째/몇 개를 누르면 다음 할 일(마지막이면 처음으로).
  카드 넘기기(StackView)는 이상하게 보여 한 줄 칸(widget_line)과 같은 방식으로 바꿨다(사용자 요청 2026-10-23). 할 일 칸 id는 widget_line과 같다(one_*).
  칸이 낮으면 위 줄은 빼고 할 일만. 할 일이 없으면 메모·안내(one_text). 폴더 이름·빈 곳은 누르지 않는다(예전엔 이름 칸이 › 버튼 옆까지 늘어나 있어,
  맨 끝 폴더에서 ›를 조금 비껴 누르면 앱이 켜졌다).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/lock_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />

  <LinearLayout
    android:id="@+id/lock_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
      android:id="@+id/lock_head"
      android:layout_width="match_parent"
      android:layout_height="28dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <FrameLayout
        android:id="@+id/lock_brand"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">
        <ImageView
          android:id="@+id/widget_mark"
          android:layout_width="wrap_content"
          android:layout_height="12dp"
          android:layout_gravity="center_vertical"
          android:adjustViewBounds="true"
          android:importantForAccessibility="no"
          android:src="@drawable/naegirok_mark" />
      </FrameLayout>
      <TextView
        android:id="@+id/lock_folder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
      <ImageView
        android:id="@+id/lock_prev"
        android:layout_width="32dp"
        android:layout_height="28dp"
        android:contentDescription="@string/prev_folder"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:src="@drawable/naegirok_chevron_left" />
      <ImageView
        android:id="@+id/lock_next"
        android:layout_width="32dp"
        android:layout_height="28dp"
        android:contentDescription="@string/next_folder"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:src="@drawable/naegirok_chevron_right" />
    </LinearLayout>

    <!-- 할 일 하나: 동그라미 · (할 일 + 아래 줄) · 몇 번째/몇 개 -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingEnd="2dp">
      <ViewFlipper
        android:id="@+id/one_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-6dp"
        android:inAnimation="@anim/widget_check_in"
        android:outAnimation="@anim/widget_check_out">
        <ImageView
          android:id="@+id/one_ring"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:padding="8dp"
          android:src="@drawable/naegirok_check_off" />
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent">
          <ImageView
            android:id="@+id/one_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="9.5dp"
            android:src="@drawable/naegirok_circle" />
          <ImageView
            android:id="@+id/one_tick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="10.5dp"
            android:src="@drawable/naegirok_tick" />
        </FrameLayout>
      </ViewFlipper>
      <!-- 누르는 자리: 할 일 + 아래 줄 전체(빈 위아래까지) -->
      <LinearLayout
        android:id="@+id/one_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
          android:id="@+id/one_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:letterSpacing="-0.02"
          android:lineSpacingMultiplier="1.1"
          android:maxLines="2"
          android:textColor="#FFFFFF"
          android:textSize="16sp" />
        <TextView
          android:id="@+id/one_meta"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="#A1A1A6"
          android:textSize="13sp"
          android:visibility="gone" />
      </LinearLayout>
      <TextView
        android:id="@+id/one_pos"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical"
        android:textColor="#A1A1A6"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
