<?xml version="1.0" encoding="utf-8"?>
<!--
  잠금화면·작은 칸 위젯, 낮은 칸(84dp 아래, HomeWidget.card): 위 줄(widget_lock_head) + 남는 자리 가운데에 할 일 하나(widget_lock_todo).
  글자나 몇 번째/몇 개를 누르면 다음 할 일(마지막이면 처음으로). 카드 넘기기(StackView)는 이상하게 보여 한 줄 칸(widget_line)과
  같은 방식으로 바꿨다(사용자 요청 2026-10-23). 넉넉한 칸은 widget_lock_roomy(위·사이·아래 간격을 같게).
  할 일이 없으면 메모·안내(one_text). 폴더 이름·빈 곳은 누르지 않는다(예전엔 이름 칸이 › 버튼 옆까지 늘어나 있어,
  맨 끝 폴더에서 ›를 조금 비껴 누르면 앱이 켜졌다).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/lock_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />

  <LinearLayout
    android:id="@+id/lock_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">
    <include
      layout="@layout/widget_lock_head"
      android:layout_width="match_parent"
      android:layout_height="26dp" />
    <include
      layout="@layout/widget_lock_todo"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
  </LinearLayout>
</FrameLayout>
