<?xml version="1.0" encoding="utf-8"?>
<!-- 작은 칸 위젯의 위 줄(widget_lock · widget_lock_roomy): 로고(누르면 앱) · 폴더 이름들. 26dp라 56dp 칸에도 들어간다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/lock_head"
  android:layout_width="match_parent"
  android:layout_height="26dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <!-- 아래 할 일 줄과 줄 맞춤(사용자 요청 2026-10-24): 로고 왼쪽 = 동그라미 왼쪽, 폭 38dp = 동그라미 칸(40 - 6 + 4)이라
       폴더 이름이 할 일 글자와 같은 자리에서 시작한다 -->
  <FrameLayout
    android:id="@+id/lock_brand"
    android:layout_width="38dp"
    android:layout_height="match_parent"
    android:paddingStart="3.5dp">
    <ImageView
      android:id="@+id/widget_mark"
      android:layout_width="wrap_content"
      android:layout_height="10.5dp"
      android:layout_gravity="center_vertical|start"
      android:adjustViewBounds="true"
      android:importantForAccessibility="no"
      android:src="@drawable/naegirok_mark" />
  </FrameLayout>
  <!-- 폴더 이름들(홈 위젯 머리와 같은 탭 줄, HomeWidget.folderTabs): 누르면 그 폴더로, 가운데로 온다. 맨 앞·맨 끝은 그 끝에.
       ‹ ›는 뺐다(사용자 요청 2026-10-24) -->
  <LinearLayout
    android:id="@+id/lock_tabs"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal" />
</LinearLayout>
