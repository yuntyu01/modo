<?xml version="1.0" encoding="utf-8"?>
<!-- 작은 칸 위젯의 할 일 하나(widget_lock · widget_lock_roomy): 동그라미 · (할 일 + 아래 줄) · 몇 번째/몇 개. id는 widget_line과 같은 one_* -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingEnd="2dp">
  <ViewFlipper
    android:id="@+id/one_check"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginStart="-6dp"
    android:inAnimation="@anim/widget_check_in"
    android:outAnimation="@anim/widget_check_out">
    <ImageView
      android:id="@+id/one_ring"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:padding="8dp"
      android:src="@drawable/naegirok_check_off" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">
      <ImageView
        android:id="@+id/one_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="9.5dp"
        android:src="@drawable/naegirok_circle" />
      <ImageView
        android:id="@+id/one_tick"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="10.5dp"
        android:src="@drawable/naegirok_tick" />
    </FrameLayout>
  </ViewFlipper>
  <!-- 누르는 자리: 할 일 + 아래 줄 전체(빈 위아래까지) -->
  <LinearLayout
    android:id="@+id/one_body"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="4dp"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <TextView
      android:id="@+id/one_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:letterSpacing="-0.02"
      android:lineSpacingMultiplier="1.1"
      android:maxLines="2"
      android:textColor="#FFFFFF"
      android:textSize="16sp" />
    <TextView
      android:id="@+id/one_meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="#A1A1A6"
      android:textSize="13sp"
      android:visibility="gone" />
  </LinearLayout>
  <TextView
    android:id="@+id/one_pos"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginStart="10dp"
    android:fontFamily="sans-serif"
    android:fontFeatureSettings="tnum"
    android:gravity="center_vertical"
    android:textColor="#A1A1A6"
    android:textSize="12sp" />
</LinearLayout>
