<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 위젯(시안): 심볼 + 폴더 이름 + ‹ › / 메모 / 할 일 / '더 보기'와 +. 줄은 NotesWidgetProvider가 직접 채운다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="25dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:layout_marginEnd="-5dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginStart="-3dp"
        android:layout_marginEnd="9.5dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/naegirok_mark" />
      <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/base_folder"
        android:letterSpacing="-0.014"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />
      <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="35.5dp"
        android:layout_height="44dp"
        android:contentDescription="@string/prev_folder"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:src="@drawable/naegirok_chevron_left" />
      <ImageView
        android:id="@+id/widget_next"
        android:layout_width="36.5dp"
        android:layout_height="44dp"
        android:contentDescription="@string/next_folder"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:src="@drawable/naegirok_chevron_right" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/widget_rows"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:paddingTop="8.5dp"
      android:paddingEnd="10dp"
      android:orientation="vertical" />

    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:paddingEnd="10dp"
      android:text="@string/widget_empty"
      android:textColor="#9C9FA6"
      android:textSize="14sp"
      android:visibility="gone" />

    <FrameLayout
      android:id="@+id/widget_footer"
      android:layout_width="match_parent"
      android:layout_height="40dp">
      <TextView
        android:id="@+id/widget_more"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="start|center_vertical"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:text="@string/more"
        android:textColor="#9C9FA6"
        android:textSize="13sp" />
      <ImageView
        android:id="@+id/widget_add"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="1dp"
        android:contentDescription="@string/add"
        android:padding="10dp"
        android:src="@drawable/naegirok_add" />
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
