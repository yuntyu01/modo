<?xml version="1.0" encoding="utf-8"?>
<!--
  작은 칸용 위젯(삼성 잠금화면의 넓은 칸, 홈의 4×1. HomeWidget.strip). 높이가 넉넉하면 두 줄:
  위 = 로고 · 폴더 이름 · 이전/다음 폴더, 아래 = 동그라미(완료) · 할 일 하나 · 몇 번째/몇 개 · 다음 할 일.
  낮으면 아래 줄만. 큰 위젯(목록)은 widget_home, 동그라미 칸은 widget_tiny.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/strip_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/naegirok_widget_bg" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
      android:id="@+id/strip_head"
      android:layout_width="match_parent"
      android:layout_height="30dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginEnd="10dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/naegirok_mark" />
      <TextView
        android:id="@+id/strip_folder"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
      <ImageView
        android:id="@+id/strip_prev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/prev_folder"
        android:padding="7dp"
        android:src="@drawable/naegirok_chevron_left" />
      <ImageView
        android:id="@+id/strip_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/next_folder"
        android:padding="7dp"
        android:src="@drawable/naegirok_chevron_right" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/strip_row"
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ViewFlipper
        android:id="@+id/strip_check"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="-8dp"
        android:inAnimation="@anim/widget_check_in"
        android:outAnimation="@anim/widget_check_out">
        <ImageView
          android:id="@+id/strip_ring"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:padding="6.5dp"
          android:src="@drawable/naegirok_check_off" />
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent">
          <ImageView
            android:id="@+id/strip_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/naegirok_circle" />
          <ImageView
            android:id="@+id/strip_tick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/naegirok_tick" />
        </FrameLayout>
      </ViewFlipper>
      <TextView
        android:id="@+id/strip_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />
      <TextView
        android:id="@+id/strip_pos"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:fontFamily="sans-serif"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical"
        android:textColor="#A1A1A6"
        android:textSize="12sp" />
      <ImageView
        android:id="@+id/strip_down"
        android:layout_width="30dp"
        android:layout_height="36dp"
        android:contentDescription="@string/next_todo"
        android:paddingStart="7dp"
        android:paddingTop="10dp"
        android:paddingEnd="7dp"
        android:paddingBottom="10dp"
        android:src="@drawable/naegirok_chevron_down" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
