<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 16+(xml-v36): 위젯 고르기 목록에는 내지 않고(hide_from_picker) 앱의 '위젯 놓기' 크기 버튼으로만 놓는다(requestPinWidget).
  안드로이드 16은 크기 판을 모두 잠금화면 고르기에도 보여 줘 삼성 잠금화면에 modo가 4개 나왔고, not_keyguard만으로는 삼성이 빼지 않았다
  (사용자 요청 2026-10-22·10-30). 잠금화면에서는 크기를 사용자가 직접 맞추니 기본(3×3) 하나만 보인다. 홈 화면의 크기 고르기는 앱에 그대로.
  나머지는 xml/naegirok_widget_info_2x2.xml과 같다(함께 바꿀 것).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:minResizeWidth="110dp"
  android:minResizeHeight="70dp"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:resizeMode="horizontal|vertical"
  android:updatePeriodMillis="0"
  android:initialLayout="@layout/widget_home"
  android:previewLayout="@layout/widget_preview"
  android:description="@string/widget_description"
  android:configure="com.yuntyu01.naegirok.widget.WidgetConfigActivity"
  android:widgetFeatures="reconfigurable|configuration_optional|hide_from_picker"
  android:widgetCategory="home_screen|not_keyguard" />
